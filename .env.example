COMPANY_NAME="Vercel Inc."
SITE_NAME="Next.js Commerce"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"

# Customer Account API (customer login / account area)
# Shopify admin -> Settings -> Customer accounts: enable "Customer accounts" (new, passwordless).
# Install the Headless channel, open its Customer Account API section, and copy:
# - Client ID
# - Shop ID (the number in the endpoint URLs, e.g. https://shopify.com/authentication/<shop_id>/oauth/authorize)
# Register callback URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback (https required, even for localhost —
# run `pnpm dev --experimental-https` and use https://localhost:3000).
# Also add <NEXT_PUBLIC_APP_URL> as a JavaScript origin and logout URI.
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
SHOPIFY_CUSTOMER_ACCOUNT_API_SHOP_ID=""
NEXT_PUBLIC_APP_URL="https://localhost:3000"

# Admin API (newsletter signup)
# Create an app in the Shopify Dev Dashboard with scopes read_customers,write_customers
# and install it on the store (custom distribution). Then EITHER paste the app's
# Client ID + Secret (dev dashboard -> app -> App settings -> Credentials) for the
# OAuth client-credentials grant, OR a static shpat_ Admin API access token if you
# have one. Server-side only — never expose.
SHOPIFY_ADMIN_CLIENT_ID=""
SHOPIFY_ADMIN_CLIENT_SECRET=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""
